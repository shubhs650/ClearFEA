#
# The compute manager's settings on the solver VPS (M12.5, ADR-107, ADR-110). bootstrap.sh copies
# this file to /etc/clearfea/manager.env (root only, mode 600) and asks for the three secrets.
# Docker reads it with --env-file: one NAME=value per line, no quotes, no spaces around "=".
# The settings are described in docs/ARCHITECTURE.md section 7, "Compute manager".
# After a change: systemctl restart clearfea-manager (running jobs keep going and are followed).

# The live site, and the secrets that let the manager in (docs/DEPLOYMENT.md sections 1.8 and 3).
CLEARFEA_API_URL=https://clearfea.triyalabs.com
CLEARFEA_WORKER_TOKEN=
CLEARFEA_ACCESS_CLIENT_ID=
CLEARFEA_ACCESS_CLIENT_SECRET=

# The name the dashboard shows for this host.
CLEARFEA_HOST_NAME=contabo-1

# The image every job container runs; the image updater points this tag at the deployed image.
CLEARFEA_JOB_IMAGE=clearfea-worker:current
CLEARFEA_JOB_NETWORK=bridge

# Lanes on the Cloud VPS 8 (8 vCPU, 24 GB; ADR-107 starting values, M12.6 measures them): the
# solve lane on CPUs 0-5 with 17 GB, the light lane (import, mesh, report) on CPU 6 with 4 GB,
# and CPU 7 and the rest of the memory left to the system, Docker and the manager.
CLEARFEA_SOLVE_CPUSET=0-5
CLEARFEA_SOLVE_MEMORY=17g
CLEARFEA_LIGHT_CPUSET=6
CLEARFEA_LIGHT_MEMORY=4g

# Docker's data directory, mounted read-only into the manager: it holds the jobs' scratch
# volumes, so no job is claimed while it has under 20 GiB free (ADR-108), and the check-ins
# report its free space for the dashboard's disk alert.
CLEARFEA_SCRATCH_PATH=/var/lib/docker
CLEARFEA_SCRATCH_MIN_FREE=20g

# Rolling back (docs/DEPLOYMENT.md section 4.3): set a tag such as src-0123456789abcdef0123 and
# the image updater loads that image instead of the deployed one; empty follows the deploys.
# Read by update-image.sh only.
CLEARFEA_IMAGE_PIN=
