{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs",
  "description": "Wire shapes of the job routes: the worker's internal routes and the signed-in user's public routes (docs/ARCHITECTURE.md sections 6 and 8). Each message is a definition under $defs.",
  "$defs": {
    "JobType": { "enum": ["noop", "import", "mesh", "solve", "report"] },
    "JobStatus": {
      "enum": ["queued", "claimed", "running", "succeeded", "failed", "cancelled", "stopped_at_limit"]
    },
    "FailureCategory": { "enum": ["user_fault", "platform_fault"] },
    "HeartbeatAction": {
      "description": "What the worker should do next: carry on, or end the job because the user cancelled it or it reached its stop limit.",
      "enum": ["continue", "cancel", "stop"]
    },
    "WorkerId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "Transfer": {
      "description": "One file a job reads or writes (ADR-005). Locally the url points at the API's /internal/jobs/{id}/files route and needs the worker token; in the cloud it is a presigned storage URL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "url"],
      "properties": {
        "name": { "description": "The file's name within the job, for example model.step.", "type": "string", "minLength": 1 },
        "direction": { "enum": ["download", "upload"] },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "ClaimedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "targetId", "params", "transfers"],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/JobType" },
        "targetId": { "type": ["string", "null"] },
        "params": {
          "description": "Job-type specific parameters, for example an ImportParams (geometry.schema.json); null when the type has none.",
          "type": ["object", "null"]
        },
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/Transfer" } }
      }
    },
    "WorkerSoftware": {
      "description": "Versions of the worker that claims a job (ADR-032), recorded on the job so a run can state what produced it. Null where the worker lacks the program.",
      "type": "object",
      "additionalProperties": false,
      "required": ["clearfea", "deckFormat", "calculix", "gmsh"],
      "properties": {
        "clearfea": {
          "description": "The worker package's version, with the source commit it was built from after a + when known, for example 0.0.0+d9d394b.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "deckFormat": { "description": "The deck generator's DECK_FORMAT.", "type": "integer", "minimum": 1 },
        "calculix": { "type": ["string", "null"], "maxLength": 100 },
        "gmsh": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "ClaimRequest": {
      "description": "Body of POST /internal/jobs/claim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId", "jobTypes"],
      "properties": {
        "workerId": { "$ref": "#/$defs/WorkerId" },
        "jobTypes": { "type": "array", "items": { "$ref": "#/$defs/JobType" } },
        "software": { "$ref": "#/$defs/WorkerSoftware" },
        "machineSize": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
          "description": "The machine size the worker runs on (M10.6, ADR-098), from CLEARFEA_MACHINE_SIZE: it is given only that size's jobs, and the default size's also takes the jobs that have no size (import, report). Left out by a local worker, which takes every size's jobs."
        }
      }
    },
    "ClaimResponse": {
      "description": "Answer to a claim when a job was claimed (HTTP 200). No job to claim is HTTP 204 with no body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job"],
      "properties": { "job": { "$ref": "#/$defs/ClaimedJob" } }
    },
    "HeartbeatRequest": {
      "description": "Body of POST /internal/jobs/{id}/heartbeat.",
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId"],
      "properties": {
        "workerId": { "$ref": "#/$defs/WorkerId" },
        "stage": { "type": ["string", "null"] },
        "log": {
          "description": "Log text the job wrote since the previous heartbeat, appended to the job's log as one chunk (ADR-030).",
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "HeartbeatResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": { "action": { "$ref": "#/$defs/HeartbeatAction" } }
    },
    "Metering": {
      "description": "What the worker measured of a job (ADR-033): billableMs is the wall-clock time from the start to the end of the job's handler on the machine, in whole milliseconds. Queue time and the worker's start-up are outside it. Sent for every job; the API charges only metered job types.",
      "type": "object",
      "additionalProperties": false,
      "required": ["billableMs"],
      "properties": {
        "billableMs": { "type": "integer", "minimum": 0, "maximum": 2592000000 }
      }
    },
    "CompleteSucceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId", "status", "metering"],
      "properties": {
        "workerId": { "$ref": "#/$defs/WorkerId" },
        "status": { "const": "succeeded" },
        "metering": { "$ref": "#/$defs/Metering" },
        "result": { "type": "object", "description": "Job-type specific summary, stored as given." }
      }
    },
    "CompleteFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId", "status", "failureCategory", "failureCause", "metering"],
      "properties": {
        "workerId": { "$ref": "#/$defs/WorkerId" },
        "status": { "const": "failed" },
        "metering": { "$ref": "#/$defs/Metering" },
        "failureCategory": { "$ref": "#/$defs/FailureCategory" },
        "failureCause": { "type": "string", "minLength": 1 },
        "failureMessage": {
          "description": "What went wrong and what to do about it, in plain language for the job's owner.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CompleteStopped": {
      "description": "The worker ended the job because a heartbeat told it to (cancel or stop, M8.2): it reports the time it used. The API records the job as cancelled or stopped at its limit, as it asked, and charges the time (DECISIONS \"Failed runs\").",
      "type": "object",
      "additionalProperties": false,
      "required": ["workerId", "status", "metering"],
      "properties": {
        "workerId": { "$ref": "#/$defs/WorkerId" },
        "status": { "const": "stopped" },
        "metering": { "$ref": "#/$defs/Metering" }
      }
    },
    "CompleteRequest": {
      "description": "Body of POST /internal/jobs/{id}/complete.",
      "oneOf": [
        { "$ref": "#/$defs/CompleteSucceeded" },
        { "$ref": "#/$defs/CompleteFailed" },
        { "$ref": "#/$defs/CompleteStopped" }
      ]
    },
    "CompletedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "targetId", "status"],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/JobType" },
        "targetId": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/JobStatus" }
      }
    },
    "CompleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job"],
      "properties": { "job": { "$ref": "#/$defs/CompletedJob" } }
    },
    "CreateJobRequest": {
      "description": "Body of POST /api/jobs. Only a noop job is queued directly; later job types are created by the routes for the records they work on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "noop" } }
    },
    "JobView": {
      "description": "A job as its owner sees it. Timestamps are ISO 8601 UTC strings.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "targetId", "status", "stage", "failureCategory", "failureCause",
        "failureMessage", "createdAt", "claimedAt", "finishedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/JobType" },
        "targetId": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/JobStatus" },
        "stage": { "type": ["string", "null"] },
        "failureCategory": { "oneOf": [{ "$ref": "#/$defs/FailureCategory" }, { "type": "null" }] },
        "failureCause": { "type": ["string", "null"] },
        "failureMessage": { "type": ["string", "null"] },
        "createdAt": { "type": "string" },
        "claimedAt": { "type": ["string", "null"] },
        "finishedAt": { "type": ["string", "null"] }
      }
    },
    "JobResponse": {
      "description": "Answer to POST /api/jobs (HTTP 201) and GET /api/jobs/{id}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["job"],
      "properties": { "job": { "$ref": "#/$defs/JobView" } }
    },
    "JobListResponse": {
      "description": "Answer to GET /api/jobs: the signed-in user's most recent jobs, newest first.",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs"],
      "properties": { "jobs": { "type": "array", "items": { "$ref": "#/$defs/JobView" } } }
    },
    "ErrorResponse": {
      "description": "Body of any 4xx or 5xx answer: what is wrong and what to do about it.",
      "type": "object",
      "required": ["error"],
      "properties": { "error": { "type": "string" } }
    }
  }
}
