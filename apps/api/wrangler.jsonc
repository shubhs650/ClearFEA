// SPDX-License-Identifier: AGPL-3.0-or-later
// Local configuration for the ClearFEA API. In Phase 0 everything runs under
// `wrangler dev`: D1 and R2 are emulated locally and persisted in .wrangler/state.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clearfea-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // node:async_hooks for Better Auth's request state (M10.3, ADR-097); nothing else from Node.
  "compatibility_flags": ["nodejs_als"],
  "dev": {
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clearfea",
      // Placeholder: only the local emulation is used in Phase 0.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The daily storage sweep (M8.6, ADR-085): raw output past retention, storage charges. Each
  // minute: lost jobs, and on the live site solver machines for waiting work (M10.7, ADR-100).
  "triggers": {
    "crons": ["0 3 * * *", "* * * * *"]
  },
  // Each signed-in user's requests to /api (M11.3, ADR-112): 120 a minute, REQUESTS_PER_MINUTE in
  // src/session/index.ts. Counted per Cloudflare location, so a limit, not an exact count.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "clearfea-files"
    }
  ]
}
