{
  "name": "@clearfea/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && pnpm db:seed && wrangler dev --test-scheduled",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seed/test-users.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:config": "node scripts/production-config.mjs",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.production.json",
    "deploy:worker": "wrangler deploy --config wrangler.production.json"
  },
  "dependencies": {
    "@clearfea/spec": "workspace:*",
    "better-auth": "1.7.10",
    "fflate": "0.8.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wrangler": "4.149.0"
  }
}
